# Resend — get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" email — must be a verified domain in Resend
# During dev you can use: onboarding@resend.dev
RESEND_FROM=DeploySafe <hello@deploysafe.in>

# Optional: Resend Audience ID to auto-add signups to a list
# Create one at resend.com/audiences
RESEND_AUDIENCE_ID=

# Your site URL (used in emails)
NEXT_PUBLIC_SITE_URL=https://deploysafe.in
