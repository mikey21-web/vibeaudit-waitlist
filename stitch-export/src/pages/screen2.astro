---
---

<html lang="en"><head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>diyaa.ai – Your AI Workforce Starts Here</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #1e3a8a;
      --secondary: #f97316;
      --accent: #10b981;
      --neon: #8b5cf6;
      --dark: #0f172a;
      --light: #f8fafc;
      --border: #e2e8f0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: var(--light);
      color: var(--dark);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ===== TYPOGRAPHY ===== */
    h1, h2, h3, h4 {
      font-weight: 700;
      line-height: 1.2;
    }

    h1 {
      font-size: clamp(2.5rem, 8vw, 4.5rem);
      font-family: 'Courier New', monospace;
      letter-spacing: -2px;
    }

    h2 {
      font-size: clamp(2rem, 6vw, 3.5rem);
      font-family: 'Courier New', monospace;
    }

    h3 {
      font-size: 1.5rem;
    }

    /* ===== ANIMATIONS ===== */
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-40px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(40px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    @keyframes shimmer {
      0% {
        background-position: -1000px 0;
      }
      100% {
        background-position: 1000px 0;
      }
    }

    /* ===== HEADER ===== */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 2px solid var(--border);
    }

    nav {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -1px;
      background: linear-gradient(135deg, var(--primary), var(--neon));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-link {
      text-decoration: none;
      color: var(--dark);
      font-weight: 600;
      transition: color 0.3s ease;
    }

    .nav-link:hover {
      color: var(--secondary);
    }

    .waitlist-btn {
      background: linear-gradient(135deg, var(--primary), var(--neon));
      color: white;
      border: none;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .waitlist-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(30, 58, 138, 0.3);
    }

    /* ===== HERO SECTION ===== */
    .hero {
      max-width: 1400px;
      margin: 0 auto;
      padding: 6rem 2rem;
      position: relative;
      overflow: hidden;
    }

    .hero-content {
      text-align: center;
      animation: slideInUp 0.8s ease-out;
    }

    .hero h1 {
      margin-bottom: 1.5rem;
      color: var(--dark);
      position: relative;
      display: inline-block;
    }

    .hero h1 span {
      background: linear-gradient(135deg, var(--secondary), var(--neon));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.3rem;
      color: #64748b;
      margin-bottom: 2rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      animation: slideInUp 0.8s ease-out 0.1s both;
    }

    .waitlist-card {
      max-width: 500px;
      margin: 0 auto;
      background: white;
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      animation: slideInUp 0.8s ease-out 0.2s both;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
    }

    .waitlist-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .form-group {
      text-align: left;
    }

    .form-label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--dark);
    }

    .form-input {
      width: 100%;
      padding: 0.875rem;
      border: 2px solid var(--border);
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s, box-shadow 0.3s;
      font-family: inherit;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--secondary);
      box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
    }

    .submit-btn {
      background: linear-gradient(135deg, var(--primary), var(--neon));
      color: white;
      border: none;
      padding: 1rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 35px rgba(30, 58, 138, 0.4);
    }

    .submit-btn:active {
      transform: translateY(0);
    }

    .early-access {
      display: inline-block;
      background: linear-gradient(135deg, #fef08a, #fed7aa);
      color: #92400e;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      animation: pulse 2s ease-in-out infinite;
    }

    .waitlist-count {
      font-size: 0.9rem;
      color: #64748b;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }

    .count-number {
      font-weight: 800;
      color: var(--secondary);
      font-size: 1.2rem;
    }

    /* ===== HERO BACKGROUND ===== */
    .hero::before {
      content: '';
      position: absolute;
      top: -100px;
      right: -100px;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(249, 115, 22, 0.1), transparent);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: -100px;
      left: -100px;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(30, 58, 138, 0.05), transparent);
      border-radius: 50%;
      pointer-events: none;
    }

    /* ===== SOCIAL PROOF ===== */
    .social-proof {
      background: white;
      border-top: 2px solid var(--border);
      border-bottom: 2px solid var(--border);
      padding: 3rem 2rem;
      margin: 4rem 0;
    }

    .social-proof-content {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      text-align: center;
    }

    .stat {
      animation: slideInUp 0.8s ease-out;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--secondary), var(--neon));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.5rem;
    }

    .stat-label {
      font-size: 0.95rem;
      color: #64748b;
      font-weight: 600;
    }

    /* ===== AGENTS SECTION ===== */
    .agents-section {
      max-width: 1400px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .section-title {
      text-align: center;
      margin-bottom: 3rem;
      animation: slideInUp 0.8s ease-out;
    }

    .section-title h2 {
      margin-bottom: 1rem;
    }

    .section-title p {
      font-size: 1.1rem;
      color: #64748b;
      max-width: 600px;
      margin: 0 auto;
    }

    .agents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .agent-card {
      background: white;
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      animation: slideInUp 0.8s ease-out;
      animation-fill-mode: both;
    }

    .agent-card:nth-child(1) { animation-delay: 0s; }
    .agent-card:nth-child(2) { animation-delay: 0.1s; }
    .agent-card:nth-child(3) { animation-delay: 0.2s; }
    .agent-card:nth-child(4) { animation-delay: 0.3s; }
    .agent-card:nth-child(5) { animation-delay: 0.4s; }
    .agent-card:nth-child(6) { animation-delay: 0.5s; }

    .agent-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      transition: left 0.5s;
    }

    .agent-card:hover {
      border-color: var(--secondary);
      box-shadow: 0 20px 40px rgba(249, 115, 22, 0.15);
      transform: translateY(-8px);
    }

    .agent-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: inline-block;
    }

    .agent-card h3 {
      margin-bottom: 0.5rem;
      color: var(--dark);
    }

    .agent-category {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      background: rgba(249, 115, 22, 0.1);
      color: var(--secondary);
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 0.75rem;
    }

    .agent-desc {
      font-size: 0.95rem;
      color: #64748b;
      margin-bottom: 1rem;
    }

    .agent-features {
      list-style: none;
      font-size: 0.85rem;
    }

    .agent-features li {
      margin-bottom: 0.5rem;
      padding-left: 1.5rem;
      position: relative;
      color: #475569;
    }

    .agent-features li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
    }

    /* ===== FEATURES SECTION ===== */
    .features-section {
      background: linear-gradient(135deg, rgba(30, 58, 138, 0.05), rgba(139, 92, 246, 0.05));
      padding: 6rem 2rem;
      border-top: 2px solid var(--border);
    }

    .features-content {
      max-width: 1400px;
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .feature-item {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      transition: all 0.3s ease;
      animation: slideInUp 0.8s ease-out;
    }

    .feature-item:hover {
      border-color: var(--secondary);
      transform: translateY(-4px);
    }

    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .feature-item h3 {
      margin-bottom: 0.75rem;
      color: var(--dark);
    }

    .feature-item p {
      color: #64748b;
      font-size: 0.95rem;
    }

    /* ===== AUTONOMOUS EXECUTION ===== */
    .execution-section {
      max-width: 1400px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .execution-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-top: 3rem;
    }

    .execution-visual {
      background: linear-gradient(135deg, var(--primary), var(--neon));
      border-radius: 16px;
      padding: 3rem;
      color: white;
      position: relative;
      overflow: hidden;
      min-height: 400px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .execution-visual::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.1), transparent);
      pointer-events: none;
    }

    .execution-visual h3 {
      position: relative;
      z-index: 1;
      font-size: 2rem;
      text-align: center;
      margin-bottom: 2rem;
    }

    .execution-steps {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .execution-step {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: rgba(255, 255, 255, 0.1);
      padding: 1rem;
      border-radius: 8px;
      backdrop-filter: blur(10px);
    }

    .step-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      font-weight: 700;
      flex-shrink: 0;
    }

    .execution-details h3 {
      margin-bottom: 1rem;
    }

    .execution-details ul {
      list-style: none;
      margin-top: 1rem;
    }

    .execution-details li {
      padding-left: 1.5rem;
      position: relative;
      margin-bottom: 0.75rem;
      color: #64748b;
    }

    .execution-details li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
    }

    @media (max-width: 768px) {
      .execution-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ===== PRICING TEASER ===== */
    .pricing-teaser {
      background: white;
      padding: 4rem 2rem;
      border-top: 2px solid var(--border);
      text-align: center;
    }

    .pricing-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .pricing-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }

    .price-card {
      background: linear-gradient(135deg, var(--light), white);
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
      animation: slideInUp 0.8s ease-out;
    }

    .price-card.popular {
      border-color: var(--secondary);
      box-shadow: 0 10px 30px rgba(249, 115, 22, 0.2);
      transform: scale(1.05);
    }

    .price-amount {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .price-period {
      color: #64748b;
      margin-bottom: 1rem;
    }

    .price-card h4 {
      margin-bottom: 0.5rem;
    }

    .price-desc {
      font-size: 0.9rem;
      color: #64748b;
      margin-bottom: 1.5rem;
    }

    .popular-badge {
      display: inline-block;
      background: var(--secondary);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    /* ===== FINAL CTA ===== */
    .final-cta {
      background: linear-gradient(135deg, var(--primary), var(--neon));
      color: white;
      padding: 6rem 2rem;
      text-align: center;
    }

    .final-cta h2 {
      margin-bottom: 1rem;
      color: white;
    }

    .final-cta p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
      color: rgba(255, 255, 255, 0.9);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-btn {
      background: white;
      color: var(--primary);
      padding: 1rem 2.5rem;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 1.1rem;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .cta-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    /* ===== FOOTER ===== */
    footer {
      background: var(--dark);
      color: #94a3b8;
      padding: 3rem 2rem;
      border-top: 2px solid var(--border);
    }

    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .footer-section h4 {
      color: white;
      margin-bottom: 1rem;
    }

    .footer-section ul {
      list-style: none;
    }

    .footer-section li {
      margin-bottom: 0.5rem;
    }

    .footer-section a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.3s;
    }

    .footer-section a:hover {
      color: white;
    }

    .footer-bottom {
      border-top: 1px solid #334155;
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-bottom p {
      font-size: 0.9rem;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      nav {
        flex-direction: column;
        gap: 1rem;
      }

      .nav-links {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
      }

      .hero {
        padding: 3rem 1rem;
      }

      .agents-grid {
        grid-template-columns: 1fr;
      }

      .social-proof-content {
        grid-template-columns: 1fr;
      }

      .price-card.popular {
        transform: scale(1);
      }
    }
  </style>
</head>
<body>
  <!-- HEADER -->
  <header>
    <nav>
      <div class="logo">diyaa.ai</div>
      <div class="nav-links">
        <a href="#agents" class="nav-link">Agents</a>
        <a href="#features" class="nav-link">Features</a>
        <a href="#pricing" class="nav-link">Pricing</a>
        <button class="waitlist-btn" onclick="scrollToWaitlist()">Join Waitlist</button>
      </div>
    </nav>
  </header>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-content">
      <div class="early-access">🚀 Early Access – Limited Spots</div>

      <h1>Your AI <span>workforce</span> starts here</h1>

      <p class="hero-subtitle">
        Hire autonomous AI agents with real phone numbers, emails, and WhatsApp. <br />
        They work 24/7. You get results.
      </p>

      <div class="waitlist-card">
        <form class="waitlist-form" onsubmit="handleWaitlistSignup(event)">
          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" class="form-input" placeholder="you@company.com" required="" id="email" />
          </div>

          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input type="text" class="form-input" placeholder="John Doe" required="" id="name" />
          </div>

          <div class="form-group">
            <label class="form-label">Company / Project</label>
            <input type="text" class="form-input" placeholder="Acme Inc" id="company" />
          </div>

          <button type="submit" class="submit-btn">Get Early Access</button>
        </form>

        <div class="waitlist-count">
          <span class="count-number" id="count">312</span> early adopters on the waitlist
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="social-proof">
    <div class="social-proof-content">
      <div class="stat">
        <div class="stat-number">12</div>
        <div class="stat-label">AI Agent Templates Ready</div>
      </div>
      <div class="stat">
        <div class="stat-number">4</div>
        <div class="stat-label">Communication Channels</div>
      </div>
      <div class="stat">
        <div class="stat-number">24/7</div>
        <div class="stat-label">Autonomous Execution</div>
      </div>
      <div class="stat">
        <div class="stat-number">₹999</div>
        <div class="stat-label">Starting Monthly Price</div>
      </div>
    </div>
  </section>

  <!-- AGENTS SECTION -->
  <section class="agents-section" id="agents">
    <div class="section-title">
      <h2>12 AI Agents. Ready to Deploy.</h2>
      <p>Pick a template and customize it to your needs. Launch in minutes.</p>
    </div>

    <div class="agents-grid">
      <!-- Finance Agents -->
      <div class="agent-card">
        <div class="agent-icon">💰</div>
        <span class="agent-category">Finance</span>
        <h3>Tax Strategist</h3>
        <p class="agent-desc">Never miss a deduction again</p>
        <ul class="agent-features">
          <li>Audit compliance</li>
          <li>GST filing</li>
          <li>Deduction tracking</li>
        </ul>
      </div>

      <div class="agent-card">
        <div class="agent-icon">📋</div>
        <span class="agent-category">Finance</span>
        <h3>Invoice Chaser</h3>
        <p class="agent-desc">Get paid on time, every time</p>
        <ul class="agent-features">
          <li>Auto-send reminders</li>
          <li>Payment tracking</li>
          <li>Escalation alerts</li>
        </ul>
      </div>

      <div class="agent-card">
