  <script>
    // Waitlist count animation
    function animateCount() {
      const countEl = document.getElementById('count');
      let count = 0;
      const target = 312;
      const increment = Math.ceil(target / 50);

      const interval = setInterval(() => {
        count += increment;
        if (count >= target) {
          countEl.textContent = target;
          clearInterval(interval);
        } else {
          countEl.textContent = count;
        }
      }, 20);
    }

    // Scroll to waitlist
    function scrollToWaitlist() {
      document.querySelector('.waitlist-card').scrollIntoView({ behavior: 'smooth' });
    }

    // Handle waitlist signup
    async function handleWaitlistSignup(event) {
      event.preventDefault();

      const email = document.getElementById('email').value;
      const name = document.getElementById('name').value;
      const company = document.getElementById('company').value;

      try {
        // Send to API endpoint
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email,
            name,
            company
          })
        });

        if (response.ok) {
          // Success
          alert('🎉 You\'re on the waitlist! Check your email for next steps.');
          event.target.reset();

          // Increment count
          const countEl = document.getElementById('count');
          const current = parseInt(countEl.textContent);
          countEl.textContent = current + 1;
        } else {
          alert('Oops! Something went wrong. Please try again.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error submitting form. Please try again.');
      }
    }

    // Initialize
    window.addEventListener('load', () => {
      animateCount();
    });

    // Intersection Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    document.querySelectorAll('.agent-card, .feature-item, .price-card').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'all 0.6s ease-out';
      observer.observe(el);
    });
  </script>


